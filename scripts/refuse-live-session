#!/usr/bin/env bash
# Exit 1 (with guidance) when PROJECT has a live `nile serve`; exit 0 otherwise.
#
# The server owns `.nile/<stem>/serve.lock` (its PID) and `session.sock` while
# it runs; a TUI attached to it keeps using that socket. The lock is the
# durable half — a clean exit removes it, and a killed owner leaves a stale PID
# that the next `nile serve` clears. So a lock whose PID is alive is the
# existing signal that the project is in use; no process scan.
set -euo pipefail

orig=${1:?usage: refuse-live-session PROJECT}
project=$orig
# Match `nile-core/src/state.rs`: an existing project resolves symlinks before
# its state directory is chosen.
if [ -e "$project" ] && command -v realpath >/dev/null; then
  project=$(realpath -- "$project")
fi
dir=$(dirname -- "$project")
stem=$(basename -- "$project")
stem=${stem%.json}
lock="$dir/.nile/$stem/serve.lock"
[ -r "$lock" ] || exit 0
read -r pid <"$lock" || exit 0
[[ $pid =~ ^[1-9][0-9]*$ ]] || exit 0
kill -0 "$pid" 2>/dev/null || exit 0
echo "refusing: a live nile serve (pid $pid) owns $orig" >&2
echo "  quit the TUI/server first — a gate run rebuilds demo-sandbox/" >&2
exit 1
